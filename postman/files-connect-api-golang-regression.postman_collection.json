    {
      "name": "06 Assets",
      "item": [
        {
          "name": "Upload Asset",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{assetFilePath}}"
                }
              ]
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('asset upload returns 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.key) { pm.environment.set('assetKey', json.data.key); }",
                  "pm.test('asset key captured', function () { pm.expect(pm.environment.get('assetKey')).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Asset Presigned URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{assetKey}}\",\n  \"expiresIn\": 300\n}"
            },
            "url": "{{baseUrl}}/assets/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('asset download returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('asset presigned URL exists', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.url).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consumer Cannot Download Asset",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{consumerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{assetKey}}\",\n  \"expiresIn\": 300\n}"
            },
            "url": "{{baseUrl}}/assets/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('consumer cannot download asset', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Asset Upload Without Token Is 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{assetFilePath}}"
                }
              ]
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('asset upload without token is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
