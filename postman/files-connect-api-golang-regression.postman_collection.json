{
  "info": {
    "_postman_id": "84b1888b-3c4c-4d5f-91ed-files-connect-regression",
    "name": "Files Connect API - Go Regression",
    "description": "Regression collection for validating the Go rewrite against the current Files Connect API behavior. Set environment variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{providerToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is not 500', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Smoke and Public",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('health body is ok', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('files-connect-api');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Public File Metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{fileKey}}\"\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/files/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('public metadata returns 200 or 404', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "pm.test('metadata uses standard envelope', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
