    {
      "name": "03 Multipart Upload",
      "item": [
        {
          "name": "Initiate Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{uploadKey}}\",\n  \"numParts\": 1,\n  \"contentType\": \"text/csv\"\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/uploads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('initiate upload returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('uploadId', json.data.uploadId);",
                  "  if (json.data.parts && json.data.parts[0]) {",
                  "    pm.environment.set('part1PresignedUrl', json.data.parts[0].presignedUrl);",
                  "  }",
                  "}",
                  "pm.test('uploadId and part URL captured', function () {",
                  "  pm.expect(pm.environment.get('uploadId')).to.not.be.empty;",
                  "  pm.expect(pm.environment.get('part1PresignedUrl')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Part 1 To Presigned URL",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "id,name\n1,postman-regression\n"
            },
            "url": "{{part1PresignedUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('storage accepts uploaded part', function () {",
                  "  pm.expect([200, 201, 204]).to.include(pm.response.code);",
                  "});",
                  "const etag = pm.response.headers.get('ETag') || pm.response.headers.get('Etag');",
                  "if (etag) { pm.environment.set('part1ETag', etag.replaceAll('\"', '')); }",
                  "pm.test('ETag captured', function () { pm.expect(pm.environment.get('part1ETag')).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{uploadKey}}\",\n  \"parts\": [\n    {\n      \"PartNumber\": 1,\n      \"ETag\": \"{{part1ETag}}\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/uploads/{{uploadId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('complete upload returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('complete upload envelope', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.key).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsupported File Type Is 415",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"blocked.exe\",\n  \"numParts\": 1,\n  \"contentType\": \"application/octet-stream\"\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/uploads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('blocked executable returns 415', function () { pm.response.to.have.status(415); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Initiate Upload For Cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{cancelUploadKey}}\",\n  \"numParts\": 1,\n  \"contentType\": \"text/csv\"\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/uploads"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cancel setup returns 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.data) { pm.environment.set('cancelUploadId', json.data.uploadId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{cancelUploadKey}}\"\n}"
            },
            "url": "{{baseUrl}}/databanks/{{databankId}}/uploads/{{cancelUploadId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cancel upload returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
