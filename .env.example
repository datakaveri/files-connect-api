# CONFIG_VERSION=2
# Bumped automatically by .github/workflows/sync-config.yml on every push
# that changes this file. Do not edit this line by hand.

# Files Connect API Environment Configuration
# Copy this file to .env and update the values for your environment.
#
# Full field reference (purpose, expected value, privileges, failure mode):
#   docs/config/file-server.md    - the Node API
#   docs/config/zip-worker.md     - workers/zip-worker
#   docs/config/report-worker.md  - workers/report-worker
#
# One .env feeds all three: Docker Compose passes the worker-relevant subset into
# the worker containers. Where the API and the workers use different names for the
# same value (STORAGE_* vs S3_*), keep both in sync.

# =============================================================================
# FILE SERVER (Node API)
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Auth feature flags - "false" disables auth entirely; never do that outside local dev
AUTH_ENABLED=false
AUTHZ_ENABLED=false

# Storage Provider Configuration
# Choose between 's3' (AWS S3 or any S3-compatible endpoint), 'minio', or 'gcs'
STORAGE_PROVIDER=minio

# Storage Configuration
# For MinIO (local development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_USE_SSL=false
STORAGE_PORT=9000

# For AWS S3 (production)
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-aws-access-key
# STORAGE_SECRET_KEY=your-aws-secret-key
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_USE_SSL=true

# For Google Cloud Storage (production)
# Uses the native @google-cloud/storage client, authenticated via one of (in order of precedence):
#   1. GCS_KEY_FILE               - path to a service account JSON key file
#   2. GCS_CLIENT_EMAIL + GCS_PRIVATE_KEY - inline service account credentials (e.g. from a k8s secret)
#   3. Application Default Credentials - if none of the above are set (GOOGLE_APPLICATION_CREDENTIALS,
#      `gcloud auth application-default login`, or GKE/Cloud Run workload identity)
# STORAGE_PROVIDER=gcs
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_KEY_FILE=/path/to/service-account.json
# GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Master switch for /v1/encryption routes (default false). Enable ONLY on TANUH
# deployments; other projects' fileservers should leave this off (endpoint 404s).
# ENCRYPTION_ENABLED=true

# Client-side envelope encryption (Cloud KMS asymmetric key, RSA_DECRYPT_OAEP_3072_SHA256)
# Clients wrap per-file AES-256 DEKs with this key's public half; the TEE unwraps
# via KMS asymmetricDecrypt. API service account needs roles/cloudkms.publicKeyViewer.
# KMS_KEY_VERSION_NAME=projects/your-project/locations/asia-south1/keyRings/tanuh/cryptoKeys/dataset-dek-wrap/cryptoKeyVersions/1
# Local development fallback (no KMS emulator exists): serve a locally generated
# RSA-3072 public key instead. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out dev-enc-private.pem
#   openssl pkey -in dev-enc-private.pem -pubout -out dev-enc-public.pem
# DEV_ENCRYPTION_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Bucket Configuration - the same bucket holds uploads, zips/ and reports/
BUCKET_NAME=files-connect-local

# File Upload Limits
MAX_SIZE_IN_MULTIPART_UPLOAD_IN_GB=5

# Additional file types allowed on upload, appended to the built-in allow-lists
# (comma-separated extensions, leading dot optional). Leave unset/empty to keep the
# defaults strict. Example: allow .zip and .py files in addition to the defaults.
# ADDITIONAL_DATABANK_FILE_TYPES=zip,py
# ADDITIONAL_ASSET_FILE_TYPES=zip,py

# Authentication Configuration
KEYCLOAK_AUTH_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=files-connect
# Static RS256 verification key; used only when ISSUER_CONFIG is not set
KEYCLOAK_PUBLIC_KEY=your-public-key-here

# Multiple IDP configuration (replaces KEYCLOAK_PUBLIC_KEY when set).
# Object keys must equal the token "iss" claim verbatim.
ISSUER_CONFIG='{"jwtIgnoreExpiry":true,"leeway":30,"jwksRefreshIntervalMs":21600000,"v2.dev.controlplane.iudx.io":{"type":"internal","jwksUrl":"https://v2.dev.controlplane.iudx.io/iudx/v2/auth/jwks","audience":[]},"https://v2.dev.keycloak.iudx.io/auth/realms/iudx-v2":{"type":"remote","jwksUrl":"https://v2.dev.keycloak.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs","audience":[]}}'

# Logging Configuration
LOG_LEVEL=info

# Elastic APM (the agent is preloaded by `pnpm start`; it is ACTIVE by default and
# targets http://127.0.0.1:8200, so set ELASTIC_APM_ACTIVE=false when no APM Server exists)
ELASTIC_APM_ACTIVE=false
ELASTIC_APM_SERVICE_NAME=files-connect-api
ELASTIC_APM_ENVIRONMENT=development
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_VERIFY_SERVER_CERT=true
ELASTIC_APM_API_KEY=

# CORS Configuration ("*" or a comma-separated origin list)
CORS_ORIGIN=*

# API Version (reported in the generated OpenAPI document)
VERSION=1.0.0

# ACL API Configuration - no trailing slash, paths are concatenated
ACL_APD_API_URL=http://localhost:8081

# Catalogue REST API (item lookup). NOT the Elasticsearch URL.
CAT_API_URL=http://localhost:8082

# RabbitMQ Configuration (audit events; hostname only, no scheme).
# The exchange must already exist - the service does not declare it.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=files-exchange
RABBITMQ_ROUTING_KEY=files.routing.key

# STS temporary access. Required even for MinIO/GCS deployments.
# For MinIO any syntactically valid ARN works, e.g. 'arn:aws:iam::minio:role/custom-role'
STS_ROLE_ARN=arn:aws:iam::123456789012:role/your-role
# Optional (default: 900 = 15 minutes); max is the role's MaxSessionDuration
STS_SESSION_DURATION_IN_SECONDS=900

# Output endpoints are disabled unless explicitly enabled. For production, prefer
# OUTPUT_STORAGE_ROLE_ARN. The existing-credentials switch is a demo fallback only.
OUTPUTS_ENABLED=false
OUTPUT_STORAGE_USE_EXISTING_CREDENTIALS=false
# OUTPUT_STORAGE_ROLE_ARN=arn:aws:iam::123456789012:role/FilesConnectOutputRole
# OUTPUT_BUCKET=example-output-bucket
# OUTPUT_REGION=ap-south-1
# OUTPUT_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# OUTPUT_UPLOAD_SIGNING_KEY=replace-with-at-least-32-random-characters
# OUTPUT_PUBLISH_TOKEN=replace-with-a-different-32-character-secret
# OUTPUT_REVIEW_DATABANK_ID=nha-output-review
# OUTPUT_WORKSPACE_DATABANK_ID=nha-output-workspace

# =============================================================================
# SHARED: REDIS + JOB QUEUES (file server, zip worker, report worker)
# Host, port, DB and queue names must be identical across all three, otherwise
# jobs are enqueued and never picked up - with no error on either side.
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_MODE=false
# REDIS_CLUSTER=true  # Legacy worker-only alias; takes precedence over REDIS_CLUSTER_MODE
# Cluster mode only, workers only; keep false unless startup nodes may change dynamically
REDIS_CLUSTER_DYNAMIC_STARTUP_NODES=false
ZIP_QUEUE_NAME=jobs:zip
REPORT_QUEUE_NAME=jobs:report
# Legacy alias for REPORT_QUEUE_NAME (use only when migrating older deployments)
# READINESS_QUEUE_NAME=jobs:report

# =============================================================================
# PYTHON WORKERS (zip-worker, report-worker)
# These are the legacy S3_* names the workers read. Keep them aligned with the
# STORAGE_* values above; in Kubernetes the Deployments remap them automatically.
# =============================================================================

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Worker equivalent of STORAGE_USE_SSL (note: the worker default is false, the API default is true)
USE_SSL=false
# Set to false only for self-signed / private-CA storage endpoints. Workers only.
S3_VERIFY_SSL=true

# ---- report-worker ----
# Required for structured scoring (column/role inference via OpenAI).
OPENAI_API_KEY=
# Catalogue index (Elasticsearch) where the readiness score is written back.
# Cluster origin only - no index, no path. Unset means reports are generated but
# the catalogue is never updated.
# ELASTICSEARCH_URL=http://your-elasticsearch:9200
ELASTIC_CAT_INDEX=tgdex__cat
ELASTIC_ID=elastic
ELASTIC_PASS=your-elasticsearch-password
# Set publishStatus=ACTIVE on the catalogue doc when a readiness report completes.
# Defaults to true; set to false for deployments that manage publishStatus elsewhere (maha).
CAT_SET_PUBLISH_STATUS=true

# ---- zip-worker ----
# CAT_URL is the ELASTICSEARCH base URL (the worker calls {CAT_URL}/tgdex__cat/_search),
# i.e. the same value as ELASTICSEARCH_URL above - NOT CAT_API_URL. All three must be
# set or the catalogue update is skipped. CAT_USERNAME/CAT_PASSWORD are the same
# Elasticsearch account as ELASTIC_ID/ELASTIC_PASS.
# CAT_URL=http://your-elasticsearch:9200
# CAT_USERNAME=your-elastic-username
# CAT_PASSWORD=your-elastic-password

# =============================================================================
# Test-only configuration (copy these to .env.test when running authenticated tests)
# =============================================================================
# DEBUG=false
# KEYCLOAK_TEST_USER_USERNAME=test-user
# KEYCLOAK_TEST_USER_PASSWORD=test-password
