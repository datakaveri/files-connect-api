# Files Connect API Environment Configuration
# Copy this file to .env and update the values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# Auth feature flags
AUTH_ENABLED=false
AUTHZ_ENABLED=false

# Storage Provider Configuration
# Choose between 's3' (AWS S3) or 'minio' (MinIO)
STORAGE_PROVIDER=minio

# Storage Configuration
# For MinIO (local development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_USE_SSL=false

# For AWS S3 (production)
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-aws-access-key
# STORAGE_SECRET_KEY=your-aws-secret-key
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_USE_SSL=true

# Bucket Configuration
BUCKET_NAME=files-connect-bucket
# Data readiness report worker uploads PDF reports to this bucket
DATAREADINESS_BUCKET=data-readiness-staging

# File Upload Limits
MAX_SIZE_IN_MULTIPART_UPLOAD_IN_GB=5

# Authentication Configuration
KEYCLOAK_AUTH_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=files-connect
KEYCLOAK_PUBLIC_KEY=your-public-key-here
KEYCLOAK_REALM=master

# Multiple IDP configuration
ISSUER_CONFIG='{"jwtIgnoreExpiry":true,"leeway":30,"jwksRefreshIntervalMs":21600000,"v2.dev.controlplane.iudx.io":{"type":"internal","jwksUrl":"https://v2.dev.controlplane.iudx.io/iudx/v2/auth/jwks","audience":[]},"https://v2.dev.keycloak.iudx.io/auth/realms/iudx-v2":{"type":"remote","jwksUrl":"https://v2.dev.keycloak.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs","audience":[]}}'

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*

# API Version
VERSION=1.0.0

# ACL API Configuration
ACL_APD_API_URL=http://localhost:8081

# Catalogue API Configuration
CAT_API_URL=http://localhost:8082

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=files-exchange
RABBITMQ_ROUTING_KEY=files.routing.key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_CLUSTER_MODE=false

# Lambda Configuration (Optional)
ZIP_LAMBDA_URL=http://localhost:8083
REPORTS_LAMBDA_URL=http://localhost:8084
LAMBDA_ACCESS_KEY=your-lambda-key
LAMBDA_SECRET_KEY=your-lambda-secret
LAMBDA_REGION=us-east-1

# Report Worker (Docker) – for structured column/role inference
# Required when running report jobs; Docker Compose passes these into the report-worker container.
# CAT_API_URL is required for dataset name resolution (see dataset_clean_name_api.py)
# ELASTICSEARCH_URL is required for updating readiness scores in catalogue (see post_to_cat_api.py)
# ELASTIC_CAT_INDEX is optional (default: tgdex__cat)
# ELASTICSEARCH_URL=http://your-elasticsearch:9200
OPENAI_API_KEY=
ELASTIC_ID=elastic
ELASTIC_PASS=your-elasticsearch-password

# Legacy S3 Configuration (for backward compatibility)
# These will be used as fallbacks if STORAGE_* variables are not set
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key


# Required
# For minio you can add random role example 'arn:aws:iam::minio:role/custom-role'
STS_ROLE_ARN=arn:aws:iam::123456789012:role/your-role

# Optional (default: 900 = 15 minutes)
STS_SESSION_DURATION_IN_SECONDS=900