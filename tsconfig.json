{
  "compilerOptions": {
    "target": "es6",
    "module": "Node16",
    "rootDir": "./src",
    "moduleResolution": "node16",
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "migration-plan",
    "build"
  ]
}
